# `setup` fills these values by opening a Feishu authorization page and creating
# an app in the user's own tenant. Keep this file private after filling it.
FEISHU_PROVIDER=auto
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOMAIN=feishu
FEISHU_SETUP_SOURCE=codex-feishu-hook-bridge

# Personal Feishu destination; fill one of these two values.
FEISHU_TARGET_USER_ID=
FEISHU_CHAT_ID=

# The sender identities allowed to control Codex sessions from Feishu.
FEISHU_ALLOWED_USER_IDS=

# Stop updates the existing card, then sends app-internal urgent to these open_ids.
# Leave empty to use FEISHU_TARGET_USER_ID for a personal chat.
FEISHU_URGENT_USER_IDS=
FEISHU_STOP_URGENT=true

FEISHU_MAX_TEXT=12000
FEISHU_STAGE_MIN_INTERVAL_MS=10000
FEISHU_COMMAND_TIMEOUT_MS=4500
FEISHU_LISTENER_RESTART_MS=3000

CODEX_COMMAND=codex
CODEX_APP_SERVER_MODE=ipc
CODEX_TURN_TIMEOUT_MS=7200000

# Keep false unless you deliberately want replies that are not threaded from a bridge card.
FEISHU_ALLOW_UNTHREADED_REPLIES=false
FEISHU_DRY_RUN=false
